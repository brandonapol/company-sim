#!/usr/bin/env bash
set -euo pipefail

if command -v gmake &>/dev/null; then
  MAKE="gmake"
else
  MAKE="make"
fi

echo "Running ${MAKE} check/fast..."
if ! "${MAKE}" check/fast; then
  echo ""
  echo "check/fast failed. Formatting: run 'make format'. Spelling: fix the word or add it to cspell.json."
  echo "GitHub Actions runs the full 'make check' on the pull request."
  exit 1
fi
